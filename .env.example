# GEMINI_API_KEY: Required for Gemini AI API calls. SERVER-ONLY.
# Local dev: put it in .env.local (gitignored). Vercel: Project Settings > Environment Variables.
# Never prefix it with VITE_ (VITE_* values are bundled into the browser; the build refuses).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key for Maps JavaScript API & Places API (New).
# This is a browser key and is visible in the client by design; restrict it by HTTP referrer.
VITE_GOOGLE_MAPS_API_KEY=""


# --- Supabase (Fenly 2.0). All three are read on the server only; never add a VITE_ prefix. ---
# Supabase Dashboard > Project Settings > Data API (URL) and > API Keys.
SUPABASE_URL=""
# Publishable key (sb_publishable_...): public by design. The server hands it to the
# browser through GET /api/config, so the browser bundle never needs a VITE_ variable.
SUPABASE_PUBLISHABLE_KEY=""
# Secret key (sb_secret_...): bypasses row-level security. SERVER-ONLY. Never print or commit it.
SUPABASE_SECRET_KEY=""

# --- Feature flags (optional) ---
# Comma list of hidden features to turn on: home_extras, scout, ask_fenn, ai_staging, mascots, house_os_extras,
# demo_listings (1.0 mock rooms in Find), id_check (Passport Level 2, demo provider),
# photo_tour (demo rooms play their photos as a moving tour)
# Empty = the 2.0 default (all hidden).
FENLY_FLAGS=""

# --- Find & Apply (all SERVER-ONLY; never add a VITE_ prefix) ---
# Resend email. Without both, notifications are recorded but not emailed.
RESEND_API_KEY=""
FENLY_EMAIL_FROM=""
# Comma list of emails that can open the review queue.
FENLY_ADMIN_EMAILS=""
# Bearer secret for GET /api/cron/daily (Vercel Cron sends it). 16+ random characters.
CRON_SECRET=""
